{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug cmake test (현재 test 파일, lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/part2/robomath/build/${fileBasenameNoExtension}",
            "cwd": "${workspaceFolder}/part2/robomath",
            "preLaunchTask": "cmake-build-current-test"
        },
        {
            "name": "debug current file (lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "cwd": "${fileDirname}",
            "preLaunchTask": "build-current-file"
        },
        {
            "name": "debug current file (gdb — 예비)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            "preLaunchTask": "build-current-file",
            "setupCommands": [
                {
                    "description": "STL 컨테이너 예쁘게 표시",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}

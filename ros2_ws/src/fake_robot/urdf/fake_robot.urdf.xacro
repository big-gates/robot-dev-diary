<robot name="fake_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="wheel_radius" value="0.08" />
    <xacro:property name="wheel_width" value="0.04" />
    <xacro:property name="track" value="0.4" />
    <xacro:property name="caster_radius" value="0.03" />

    <material name="blue">
        <color rgba="0.2 0.4 0.8 1.0" />
    </material>
    <material name="black">
        <color rgba="0.1 0.1 0.1 1.0" />
    </material>

    <xacro:macro name="wheel" params="prefix reflect">
        <link name="${prefix}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}" />
                </geometry>
                <origin rpy="1.5708 0 0" xyz="0 0 0" />
                <material name="black" />
            </visual>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link" />
            <child link="${prefix}_wheel" />
            <origin xyz="0 ${reflect * track / 2} 0" rpy="0 0 0" />
            <axis xyz="0 1 0" />
        </joint>
    </xacro:macro>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.4 0.3 0.1" />
            </geometry>
            <material name="blue" />
        </visual>
    </link>

    <link name="laser">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.04" />
            </geometry>
            <material name="black" />
        </visual>
    </link>

    <joint name="laser_joint" type="fixed">
        <parent link="base_link" />
        <child link="laser" />
        <origin xyz="0.2 0 0.1" rpy="0 0 0" />
    </joint>

    <link name="caster">
        <visual>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <material name="black" />
        </visual>
    </link>

    <joint name="caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster"/>
        <origin xyz="-0.15 0 ${-wheel_radius + caster_radius}" rpy ="0 0 0"/>
    </joint>
    
    <xacro:wheel prefix="left" reflect="1" />
    
    <xacro:wheel prefix="right" reflect="-1" />
</robot>